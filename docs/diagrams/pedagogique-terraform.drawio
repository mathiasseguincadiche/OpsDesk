<mxfile host="Collection V24"><diagram id="pedagogique-terraform" name="pedagogique-terraform"><mxGraphModel dx="1000" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="400" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=1;arcSize=4;fillColor=#F6F8FC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1000" height="400" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:15px&quot;&gt;srv-admin&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#596A80&quot;&gt;poste de pilotage&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#FFFFFF;strokeColor=#2864F0;strokeWidth=1.5;verticalAlign=middle;container=1;collapsible=0;align=left;verticalAlign=top;spacingLeft=18;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="28" y="40" width="420" height="250" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#7549D8&quot;&gt;&lt;b&gt;CE QUE TU VEUX&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;main.tf&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#596A80&quot;&gt;versionné dans Git&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#F3EFFF;strokeColor=#7549D8;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="50" width="170" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#A85A22&quot;&gt;&lt;b&gt;CE QUE TERRAFORM GÈRE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;terraform.tfstate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#596A80&quot;&gt;hors de Git, copié ailleurs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#FFFFFF;strokeColor=#C66A29;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="230" y="50" width="170" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:14px&quot;&gt;terraform plan&lt;/b&gt; compare les deux à la réalité, puis&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;terraform apply&lt;/b&gt; exécute le plan accepté" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#FFFFFF;strokeColor=#C9D3E2;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="160" width="380" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#C66A29;strokeColor=#C66A29;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:15px&quot;&gt;Hôte Fedora&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#596A80&quot;&gt;libvirt · KVM&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#FFFFFF;strokeColor=#008D7B;strokeWidth=1.5;verticalAlign=middle;container=1;collapsible=0;align=left;verticalAlign=top;spacingLeft=18;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="552" y="40" width="420" height="250" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#007C6C&quot;&gt;&lt;b&gt;CE QUI EXISTE VRAIMENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;machines, disques, réseaux vus par libvirt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#EAF8F3;strokeColor=#008D7B;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="c10"><mxGeometry x="20" y="50" width="380" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:14px&quot;&gt;srv-app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;créée par Terraform&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#FFFFFF;strokeColor=#596A80;strokeWidth=1.5;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="c10"><mxGeometry x="20" y="140" width="180" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&quot;font-size:14px&quot;&gt;srv-k3s&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;créée par Terraform&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#FFFFFF;strokeColor=#596A80;strokeWidth=1.5;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="c10"><mxGeometry x="220" y="140" width="180" height="70" as="geometry"/></mxCell><mxCell id="c14" value="qemu+ssh" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=12;labelBackgroundColor=#F6F8FC;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c15" value="Terraform compare trois choses : &lt;b&gt;ce que tu veux&lt;/b&gt; (le code), &lt;b&gt;ce qu'il croit gérer&lt;/b&gt; (le state) et &lt;b&gt;ce qui existe vraiment&lt;/b&gt;. Le plan est la différence. Sans le state, Terraform ne reconnaît plus les machines qu'il a créées et propose de les recréer." style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#33445D;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="306" width="944" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>