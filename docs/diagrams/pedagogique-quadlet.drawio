style=&quot;font-size:13px&quot;&gt;le générateur Quadlet&lt;br&gt;transforme chaque fichier&lt;br&gt;en service systemd&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#FFFFFF;strokeColor=#C9D3E2;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="330" y="50" width="250" height="170" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#007C6C&quot;&gt;&lt;b&gt;CE QUI TOURNE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;demo.service&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;démarré au boot, relancé&lt;br&gt;s'il s'arrête, journaux&lt;br&gt;dans journalctl&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#EAF8F3;strokeColor=#008D7B;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="640" y="50" width="270" height="170" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c10" value="Tu ne lances pas les conteneurs à la main : tu &lt;b&gt;décris&lt;/b&gt; chacun dans un fichier, et systemd s'occupe du reste (ordre de démarrage, redémarrage, journaux). Le conteneur ne vit que tant que son service existe ; les données vivent dans le volume." style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#33445D;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="306" width="944" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>