t-size:12px&quot;&gt;laisse-t-il&lt;br&gt;passer ce flux ?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#596A80&quot;&gt;firewall-cmd&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#F3EFFF;strokeColor=#7549D8;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="508" y="62" width="140" height="150" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c12" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#007C6C&quot;&gt;&lt;b&gt;ÉTAPE 5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Le serveur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;est-il celui&lt;br&gt;attendu ?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#596A80&quot;&gt;empreinte de clé&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#EAF8F3;strokeColor=#007C6C;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="668" y="62" width="140" height="150" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#007C6C&quot;&gt;&lt;b&gt;ÉTAPE 6&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Le compte&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;est-il accepté,&lt;br&gt;avec quels droits ?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#596A80&quot;&gt;id · sudo -l&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#EAF8F3;strokeColor=#007C6C;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="828" y="62" width="140" height="150" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c16" value="Chaque étape répond à une seule question. Un succès à une étape ne prouve pas la suivante : un &lt;b&gt;ping&lt;/b&gt; qui répond ne dit rien du port 22, et une adresse joignable ne dit rien du compte. On s'arrête à la première étape en échec, et on ne change qu'une chose à la fois." style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#33445D;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="226" width="944" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>