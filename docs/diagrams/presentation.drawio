<mxfile host="app.diagrams.net" modified="2026-11-13T00:00:00.000Z" agent="OpsDesk" version="24.7.17" type="device"><diagram id="OpsDesk_presentation_reorganisee" name="Présentation OpsDesk" alt="Schéma de présentation d’OpsDesk. En haut, le service : un utilisateur consulte les tickets dans un navigateur, l’application OpsDesk (Flask et Gunicorn) lit et écrit dans PostgreSQL. En dessous, le parcours en trois phases : P1 préparer et automatiser avec Rocky Linux, Terraform, Ansible et Podman ; P2 livrer et conserver avec GitHub Actions, Trivy, la sauvegarde et la restauration ; P3 orchestrer et maintenir avec K3s, Prometheus, Grafana et k6. Vue de présentation : étapes de formation, pas un plan de câblage réseau."><mxGraphModel dx="1640" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1080" math="0" shadow="0" background="#F6F8FC" adaptiveColors="none"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="zone_page" value="" style="rounded=0;html=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1640" height="1080" as="geometry" /></mxCell><mxCell id="3" value="" style="rounded=0;arcSize=5;whiteSpace=wrap;html=0;fillColor=#2864F0;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1640" height="10" as="geometry" /></mxCell><mxCell id="4" value="OpsDesk — Un service de tickets pour apprendre l’InfraOps" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=34;fontColor=#1D293B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="29" width="974" height="46" as="geometry" /></mxCell><mxCell id="6" value="Une application concrète pour comprendre le déploiement, l’automatisation et l’exploitation." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Ari