nt style=&quot;font-size:12px&quot; color=&quot;#2864F0&quot;&gt;&lt;b&gt;GRAFANA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px&quot;&gt;tableaux de bord&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;lit Prometheus&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#1D293B;fillColor=#EDF3FF;strokeColor=#2864F0;strokeWidth=1.5;verticalAlign=middle;" vertex="1" parent="c7"><mxGeometry x="290" y="140" width="240" height="70" as="geometry"/></mxCell><mxCell id="c11" value="lit" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=0;exitY=0.25;entryX=1;entryY=0.5;fontSize=12;labelBackgroundColor=#F6F8FC;" edge="1" parent="1" source="c8" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c12" value="lit" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=0;exitY=0.75;entryX=1;entryY=0.5;fontSize=12;labelBackgroundColor=#F6F8FC;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;fontFamily=Arial;fontSize=11;fontColor=#33445D;strokeColor=#33445D;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;labelBackgroundColor=none;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="c10" target="c8"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c15" value="Prometheus &lt;b&gt;va chercher&lt;/b&gt; les mesures : ce sont les flèches « lit ». Une alerte est une règle évaluée sur ces mesures ; ici, aucune n'envoie de message, elles s'affichent dans Prometheus et Grafana. Si srv-k3s tombe, la supervision tombe avec." style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#33445D;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="290" width="944" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>