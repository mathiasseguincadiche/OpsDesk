# Configuration facultative : la démonstration locale fonctionne sans .env.
# Copier uniquement si vous souhaitez modifier les valeurs par défaut.
# Valeurs publiques de démonstration, jamais pour un service sur serveur.

# Version retournée par /version pour identifier précisément l'application lancée.
APP_VERSION=2.0.0
APP_REVISION=dev
ENVIRONMENT=development

# PostgreSQL
DB_NAME=opsdesk
DB_USER=opsdesk
DB_PASSWORD=change-me-db-password

# Signature des jetons JWT (valeur de démonstration)
JWT_SECRET=change-me-with-a-long-random-secret-of-48-chars

# Premier administrateur (créé au premier démarrage uniquement)
ADMIN_EMAIL=admin@opsdesk.local
ADMIN_PASSWORD=change-me-admin

# Données de démonstration (16 tickets, 5 utilisateurs, mot de passe Demo1234!).
# OBLIGATOIRE : SEED_DEMO_DATA=false si ENVIRONMENT=production, sinon démarrage refusé.
SEED_DEMO_DATA=true
# Inscription libre des collaborateurs depuis la page de connexion
ALLOW_REGISTRATION=true

# Niveau de journalisation de l'API : INFO par défaut, DEBUG uniquement pour diagnostiquer.
LOG_LEVEL=INFO
# Ports de la pile locale : publiés uniquement sur 127.0.0.1.
HTTP_PORT=8080
API_PORT=8000
