# Copier ce fichier en .env puis changer TOUTES les valeurs « change-me ».
# Générer un secret : openssl rand -base64 48

APP_VERSION=2.0.0
APP_REVISION=dev
ENVIRONMENT=production

# PostgreSQL
DB_NAME=opsdesk
DB_USER=opsdesk
DB_PASSWORD=change-me-db-password

# Signature des jetons JWT (32 caractères minimum)
JWT_SECRET=change-me-with-a-long-random-secret-of-48-chars

# Premier administrateur (créé au premier démarrage uniquement)
ADMIN_EMAIL=admin@opsdesk.local
ADMIN_PASSWORD=change-me-admin

# Données de démonstration (16 tickets, 5 utilisateurs, mot de passe Demo1234!)
SEED_DEMO_DATA=true
# Inscription libre des collaborateurs depuis la page de connexion
ALLOW_REGISTRATION=true

LOG_LEVEL=INFO
HTTP_PORT=8080
API_PORT=8000
